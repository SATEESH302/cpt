APP_NAME=Diagnostic Platform API
APP_VERSION=1.0.0
SERVICE_NAME=diagnostic-platform-api
# Management/pricing APIs are local only; active catalog GETs remain public.
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# Copy to .env and supply the local account's credentials; never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=diagnostic_platform
DB_USER=your_mysql_username
DB_PASSWORD=replace_with_your_local_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
DB_USE_NULL_POOL=false
DB_VERIFY_ON_STARTUP=true

# Secure HttpOnly __Host- cookies are mandatory in staging/production (HTTPS).
# Development/test use HttpOnly cookies over local HTTP, always SameSite=Lax.
AUTH_SESSION_SECONDS=3600
AUTH_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_ATTEMPTS=10
AUTH_IP_ATTEMPTS=50
